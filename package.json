{
  "name": "ai-studio-pro",
  "version": "2.2.0",
  "description": "AI Studio Pro — 自定义模型图片/视频生成桌面工具",
  "main": "electron-main.js",
  "author": "AI Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "build": "electron-builder --win",
    "build-dir": "electron-builder --win --dir",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.aistudio.pro",
    "productName": "AI Studio Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "publish": {
        "provider": "generic",
        "url": "http://your-update-server.com/ai-studio-pro/"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Studio Pro",
      "artifactName": "AI-Studio-Pro-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AI-Studio-Pro-Portable-${version}.exe"
    }
  }
}
